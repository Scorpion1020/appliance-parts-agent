OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-nano
MODEL_PROVIDER=bailian
# For Alibaba Cloud Beijing: MODEL_PROVIDER=bailian; enable Free Quota Only in console first.
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_MODEL=qwen-plus
# Only add models with Free Quota Only enabled; maximum three backups.
DASHSCOPE_FALLBACK_MODELS=
# Optional shared demo protection (ASCII credentials); required before remote exposure.
DEMO_ACCESS_USER=demo
DEMO_ACCESS_PASSWORD=
# Leave true with HTTPS; compose uses false only for its loopback HTTP binding.
COOKIE_SECURE=true
# Set to the public HTTPS origin behind a reverse proxy, e.g. https://agent.example.com.
# APP_ORIGIN=
SHOPPING_AGENT_URL=http://127.0.0.1:8000
# python_graph: Python LangGraph; tool_loop: previous TypeScript loop; rules: offline baseline.
AGENT_EXECUTION_MODE=python_graph
# Optional local hybrid retrieval requires: python -m app.agent.vector_search --build
SHOPPING_AGENT_RETRIEVAL=bm25
